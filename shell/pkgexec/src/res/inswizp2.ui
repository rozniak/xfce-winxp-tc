<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="WinTCWizard97Page" id="page">
    <property name="visible">True</property>
    <property name="is-exterior-page">False</property>
    <property name="orientation">vertical</property>
    <property name="title">Installing Software</property>
    <property name="subtitle">The package is currently being installed</property>

    <child>
      <object class="GtkLabel">
        <property name="visible">True</property>
        <property name="label">Please wait while your software is installed.</property>
        <property name="xalign">0.0</property>

        <style>
          <class name="wintc-mb-md" />
        </style>
      </object>
    </child>

    <child>
      <object class="GtkLabel">
        <property name="visible">True</property>
        <property name="label">Progress:</property>
        <property name="xalign">0.0</property>

        <style>
          <class name="wintc-mb-sm" />
        </style>
      </object>
    </child>

    <child>
      <object class="GtkProgressBar" id="progress-pkg">
        <property name="visible">True</property>
      </object>
    </child>
  </object>
</interface>
