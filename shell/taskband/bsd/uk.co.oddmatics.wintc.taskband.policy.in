<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Windows Total Conversion</vendor>
  <vendor_url>https://github.com/rozniak/xfce-winxp-tc</vendor_url>

  <!--
    Same defaults as NetworkManager's network-control: the user sitting at
    the machine may switch adapters on and off and renew leases
  -->
  <action id="uk.co.oddmatics.wintc.taskband.network-control">
    <description>Change network connections</description>
    <message>Authentication is required to change network connections</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/wintc/wintc-netctl</annotate>
  </action>
</policyconfig>
