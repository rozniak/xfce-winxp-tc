<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="WinTCShOpenWithDialog" parent="GtkWindow">
    <property name="title">Open With</property>
    <property name="resizable">False</property>

    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>

        <child>
          <object class="GtkGrid">
            <property name="visible">True</property>

            <child>
              <object class="GtkImage">
                <property name="visible">True</property>
                <property name="icon-name">folder</property>
                <property name="pixel-size">32</property>
                <property name="valign">GTK_ALIGN_START</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">0</property>
                <property name="height">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label">Choose the program you want to use to open this file:</property>

                <style>
                  <class name="wintc-mb-md" />
                  <class name="wintc-ml-md" />
                </style>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="label_file">
                <property name="visible">True</property>
                <property name="label">File: %s</property>
                <property name="xalign">0.0</property>

                <style>
                  <class name="wintc-ml-md" />
                  <class name="wintc-mt-md" />
                </style>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">1</property>
              </packing>
            </child>

            <style>
              <class name="wintc-mb-md" />
            </style>
          </object>
        </child>

        <child>
          <object class="GtkFrame">
            <property name="visible">True</property>
            <property name="label">Programs</property>

            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>

                <child>
                  <object class="GtkTreeView" id="tree_view">
                    <property name="visible">True</property>
                    <property name="headers-visible">False</property>

                    <style>
                      <class name="wintc-mb-md" />
                      <class name="wintc-ml-lg" />
                      <class name="wintc-mr-lg" />
                      <class name="wintc-mt-md" />
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkCheckButton" id="check_mime">
                    <property name="visible">True</property>
                    <property name="label">Always use the selected program to open this kind of file</property>

                    <style>
                      <class name="wintc-ml-lg" />
                      <class name="wintc-mr-lg" />
                    </style>
                  </object>
                </child>

                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>

                    <child>
                      <object class="GtkButton" id="button_browse">
                        <property name="visible">True</property>
                        <property name="label">Browse...</property>
                        <property name="halign">GTK_ALIGN_END</property>
                      </object>

                      <packing>
                        <property name="pack-type">end</property>
                      </packing>
                    </child>

                    <style>
                      <class name="wintc-button-box" />
                      <class name="wintc-mb-lg" />
                      <class name="wintc-ml-lg" />
                      <class name="wintc-mr-lg" />
                      <class name="wintc-mt-md" />
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <style>
              <class name="wintc-mt-sm" />
            </style>
          </object>
        </child>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="max-width-chars">60</property>
            <property name="wrap">True</property>
            <property name="label">If the program you want is not in the list or on your computer, you can look for the appropriate program on the web.</property>

            <style>
              <class name="wintc-mb-md" />
              <class name="wintc-mt-md" />
            </style>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>

            <child>
              <object class="GtkButton" id="button_cancel">
                <property name="visible">True</property>
                <property name="label">Cancel</property>
              </object>
              <packing>
                <property name="pack-type">end</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_ok">
                <property name="visible">True</property>
                <property name="label">OK</property>
              </object>
              <packing>
                <property name="pack-type">end</property>
              </packing>
            </child>

            <style>
              <class name="wintc-button-box" />
              <class name="wintc-mb-sm" />
            </style>
          </object>
        </child>

        <style>
          <class name="wintc-mb-md" />
          <class name="wintc-ml-lg" />
          <class name="wintc-mr-lg" />
          <class name="wintc-mt-md" />
        </style>
      </object>
    </child>
  </template>
</interface>
